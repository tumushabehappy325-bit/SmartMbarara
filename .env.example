# ============================================================
# Smart Mbarara – Required Environment Variables
# ============================================================
# Copy this file to .env (for local dev) and never commit .env.
#
# On Vercel: add these in your project → Settings → Environment Variables
# ============================================================

# PostgreSQL connection string (required)
# Get a free database from: https://neon.tech or https://supabase.com
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/smart_mbarara?sslmode=require
